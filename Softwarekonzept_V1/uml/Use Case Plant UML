@startuml ClimateCanary_UseCases

left to right direction
skinparam packageStyle rectangle

actor "Mitarbeiter" as EMP
actor "Abteilungsleiter" as DM
actor "Geschäftsführung" as SM
actor "Hausverwalter" as BA
actor "Systemadministrator" as SA

EMP <|-- DM

package "Authentifizierung" {
    usecase "Anmelden / Abmelden" as UC_AUTH
}

package "Zugriff auf Messdaten\n" {
    usecase "Aktuelle Messungen anzeigen\n(eigenes Büro – wenn min. Belegung ≥5 erreicht)" as UC_OWN_CURR
    usecase "Historische Daten eigenes Büro anzeigen\n(volle Granularität, Tag/Woche/Monat)" as UC_OWN_HIST
    usecase "Aktuelle Messungen anzeigen\n(gemeinsame Bereiche der eigenen Abteilung)" as UC_CA_CURR
    usecase "Historische Daten anzeigen\n(gemeinsame Bereiche, volle Granularität)" as UC_CA_HIST
    usecase "Historische Raumdaten anzeigen\n(Büro-Räume – reduzierte Granularität / über Mindestbelegung)\n(z.B. Tagesdurchschnitte)" as UC_DEPT_HIST
    usecase "Historische Raumdaten anzeigen\n(gemeinsame Bereiche – volle Granularität)" as UC_DEPT_CA
    usecase "Alle Räume anzeigen – volle Granularität\n(keine Nutzer-Raum-Zuordnung sichtbar)" as UC_ALL_ROOMS
    usecase "Aggregiertes unternehmensweites Dashboard anzeigen\n(nur Abteilungsebene)" as UC_COMPANY
    usecase "Trendindikatoren anzeigen\n(Abteilungs- & Unternehmensebene)" as UC_TRENDS
}


package "Grenzwertverletzungen\n" {
    usecase "Echtzeitalarm + Verbesserungstip lesen\n(eigenes Büro)" as UC_ALERT_OWN
    usecase "Aktive & historische Verletzungen anzeigen\npro Raum (Abteilungsbereich)" as UC_VIOL_DEPT
    usecase "Anzahl & Häufigkeit von Verletzungen anzeigen\npro Abteilung (anonymisiert, nicht auf einzelne Räume zurückführbar)" as UC_VIOL_MGMT
    usecase "Aktive & historische Verletzungen anzeigen\nalle Räume (Gebäudebereich)" as UC_VIOL_BA
    usecase "Grenzwerte pro Raum konfigurieren\n(Temperatur / Luftfeuchtigkeit / Luftqualität)" as UC_THRESH_CFG
    usecase "Verbesserungstipps für Verletzungen verwalten" as UC_TIPS
}


package "Abwesenheitsmanagement\n" {
    usecase "Eigene Abwesenheit verwalten" as UC_ABS_OWN
    usecase "Abwesenheiten der Abteilung anzeigen\n(um Mindestbelegung zu prüfen)" as UC_ABS_DEPT
}


package "Hardware- und Gebäudeverwaltung\n" {
    usecase "Gebäude, Abteilungen & Räume registrieren" as UC_BUILDING
    usecase "Raspberry Pi registrieren\n" as UC_REG_RPI
    usecase "Sensorstation registrieren\n" as UC_REG_SS
    usecase "Sensorstation Raspberry Pi zuweisen" as UC_ASSIGN_SS
    usecase "Geräte für Räume einrichten und konfigurieren" as UC_SETUP_DEV
}


package "Benutzerverwaltung\n" {
    usecase "Benutzer erstellen / bearbeiten / löschen" as UC_USR_MGMT
    usecase "Rollen zu Benutzern zuweisen" as UC_ROLE_ASSIGN
    usecase "Benutzer Räumen zuweisen" as UC_ROOM_ASSIGN
}

EMP --> UC_AUTH
BA  --> UC_AUTH
SA  --> UC_AUTH

' Zuweisung der Anwendungsfälle zu Rollen
' Mitarbeiter
EMP --> UC_OWN_CURR
EMP --> UC_OWN_HIST
EMP --> UC_CA_CURR
EMP --> UC_CA_HIST
EMP --> UC_ALERT_OWN
EMP --> UC_ABS_OWN

' Abteilungsleiter
DM  --> UC_DEPT_HIST
DM  --> UC_DEPT_CA
DM  --> UC_VIOL_DEPT
DM  --> UC_ABS_DEPT

' Geschäftsführung
SM  --> UC_COMPANY
SM  --> UC_TRENDS
SM  --> UC_VIOL_MGMT

' Hausverwalter
BA  --> UC_ALL_ROOMS
BA  --> UC_VIOL_BA
BA  --> UC_THRESH_CFG
BA  --> UC_TIPS

' Systemadministrator
SA  --> UC_BUILDING
SA  --> UC_REG_RPI
SA  --> UC_REG_SS
SA  --> UC_ASSIGN_SS
SA  --> UC_USR_MGMT
SA  --> UC_ROLE_ASSIGN
SA  --> UC_ROOM_ASSIGN
SA  --> UC_SETUP_DEV

@enduml